# Google Drive OAuth (Google Cloud Console → APIs & Services → Credentials)
# Scope used: drive.appdata (non-sensitive, no app verification required)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Dropbox OAuth (Dropbox App Console → App key)
# Access type: App folder only
VITE_DROPBOX_CLIENT_ID=your-dropbox-app-key

# Ask AI (Bring-Your-Own-Key LLM insights)
# Dark-launch switch — set to "true" to surface the Ask AI launcher + menu item.
# Users enter their own provider API key in-app; no LLM key belongs in env.
VITE_ENABLE_ASK_AI=false
